TELEGRAM_TOKEN=your_telegram_bot_token_here

# DEFAULT chat provider: groq, bedrock, or nanogpt. Groq's free tier caps at
# 100k tokens/day (~15 messages, less than one full session); bedrock has no
# daily cap; nanogpt is a prepaid router over third-party models (its
# data-processing review is still OPEN — docs/privacy-compliance.md §8).
# Speech-to-text always stays on Groq Whisper either way, so GROQ_API_KEY is
# still needed for voice messages.
#
# Every provider whose env vars are set below is SELECTABLE per user via
# /provider; LLM_PROVIDER is only the default for users who never chose.
LLM_PROVIDER=groq
LLM_MODEL=              # overrides the DEFAULT provider's model (empty = default).
                        # Applies to LLM_PROVIDER only — a per-user switch to another
                        # provider uses that provider's own *_MODEL var below.
LLM_TIMEOUT_SECONDS=90  # never leave this unset: the SDK default is 600s x 2 retries.
                        # The SDK's own retries are switched off (max_retries=0), so
                        # this is a real ceiling: one message waits at most
                        # 2 x this + 2s (llm_client._chat_completion's single retry)
LLM_SLOW_CALL_WARN_SECONDS=20  # log a warning for LLM calls slower than this
DAILY_BUDGET_USD=2.0    # hard cap on real LLM $ spend/day (Bedrock only - Groq's
                        # free-tier model has no price and self-limits via its own
                        # daily token cap); refuses further calls once reached,
                        # resets at midnight local server time

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile     # groq chat model
BEDROCK_MODEL=          # bedrock chat model when bedrock is NOT the default (else LLM_MODEL)
# NanoGPT (optional third provider; selectable via /provider once configured):
NANOGPT_API_KEY=        # empty = nanogpt not offered
NANOGPT_MODEL=          # REQUIRED to offer nanogpt — it routes many models, no default
NANOGPT_BASE_URL=       # empty = https://nano-gpt.com/api/v1
GROQ_WHISPER_MODEL=whisper-large-v3    # voice transcription, always Groq
ALLOWED_USERS=123456789,987654321
OWNER_CHAT_ID=         # Optional: your chat ID; receives error notifications and /bug reports
DATA_RETENTION_DAYS=   # Auto-delete inactive users after N days (empty = off)
TIMEZONE=              # Scheduler timezone, e.g. Europe/Berlin (empty = server-local)
# No Fernet key belongs in this file: the bot takes keys only via /unlock and
# keeps them in RAM. (evals/report_session_quality.py — an offline evaluation
# script, not the bot — prompts for the key; only where there is no TTY can it
# read SELF_REFLECTION_FERNET_KEY from the shell environment of that one run.
# Never pass a key on a command line — /proc/<pid>/cmdline is world-readable.)
SELF_REFLECTION_DATA_DIR=   # test/sim seam; empty = <repo>/data

BACKUP_REMOTE=         # Optional: rclone destination (e.g. gdrive:cbt-backups) for a nightly off-site copy of backups/ (empty = off)

# Bedrock: read by the bot when LLM_PROVIDER=bedrock (default model
# mistral.mistral-large-3-675b-instruct), and by the simulator regardless.
BEDROCK_ENDPOINT_URL=https://bedrock-mantle.us-east-1.api.aws/v1  # also sim/persona_llm.py
BEDROCK_API_KEY=your_bedrock_api_key_here                         # also sim/harness.py --bot-provider bedrock
AWS_BEARER_TOKEN_BEDROCK=   # alternative to BEDROCK_API_KEY; either satisfies the client
SIM_GROQ_API_KEY=your_test_only_groq_api_key_here                 # sim/harness.py --live runs;
                                                                   # dedicated key so simulator
                                                                   # testing never shares the
                                                                   # production bot's GROQ_API_KEY quota
